# Generated by aip; `aip integrations disable dolphin` removes it.
[Desktop Entry]
Type=Service
Name=aip
MimeType=inode/directory;
X-KDE-Submenu=aip
X-KDE-Priority=TopLevel
Actions=aip-choose;aip-none-claude;aip-none-pi;aip-none-claude-desktop;aip-coder-claude;aip-coder-pi;aip-coder-claude-desktop;aip-writer-claude;aip-writer-pi;aip-writer-claude-desktop;

[Desktop Action aip-choose]
Name=Choose…
Icon=utilities-terminal
Exec="/opt/My Apps/aip \\"2\\"/aip" pick %f

[Desktop Action aip-none-claude]
Name=No persona · Claude Code
Icon=utilities-terminal
Exec="/opt/My Apps/aip \\"2\\"/aip" launch none claude --terminal --dir %f

[Desktop Action aip-none-pi]
Name=No persona · Pi
Icon=utilities-terminal
Exec="/opt/My Apps/aip \\"2\\"/aip" launch none pi --terminal --dir %f

[Desktop Action aip-none-claude-desktop]
Name=No persona · Claude desktop
Icon=utilities-terminal
Exec="/opt/My Apps/aip \\"2\\"/aip" launch none claude-desktop --dir %f

[Desktop Action aip-coder-claude]
Name=coder · Claude Code
Icon=utilities-terminal
Exec="/opt/My Apps/aip \\"2\\"/aip" launch coder claude --terminal --dir %f

[Desktop Action aip-coder-pi]
Name=coder · Pi
Icon=utilities-terminal
Exec="/opt/My Apps/aip \\"2\\"/aip" launch coder pi --terminal --dir %f

[Desktop Action aip-coder-claude-desktop]
Name=coder · Claude desktop
Icon=utilities-terminal
Exec="/opt/My Apps/aip \\"2\\"/aip" launch coder claude-desktop --dir %f

[Desktop Action aip-writer-claude]
Name=writer · Claude Code
Icon=utilities-terminal
Exec="/opt/My Apps/aip \\"2\\"/aip" launch writer claude --terminal --dir %f

[Desktop Action aip-writer-pi]
Name=writer · Pi
Icon=utilities-terminal
Exec="/opt/My Apps/aip \\"2\\"/aip" launch writer pi --terminal --dir %f

[Desktop Action aip-writer-claude-desktop]
Name=writer · Claude desktop
Icon=utilities-terminal
Exec="/opt/My Apps/aip \\"2\\"/aip" launch writer claude-desktop --dir %f
