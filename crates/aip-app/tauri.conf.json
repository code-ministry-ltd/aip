{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aip",
  "mainBinaryName": "aip",
  "identifier": "ltd.codeministry.aip",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aip",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Personas and skills for Claude Code and Pi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "aip"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/code-ministry-ltd/aip/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
